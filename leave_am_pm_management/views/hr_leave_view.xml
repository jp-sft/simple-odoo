<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leave_form_custom_am_pm" model="ir.ui.view">
        <field name="name">hr.leave.form.custom.am.pm</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/group[position()=1]" position="replace">
                <group>
                    <field name="date_from" invisible="1"/>
                    <field name="request_hour_from" invisible="1"/>
                    <field name="date_to" invisible="1"/>
                    <field name="request_hour_to" invisible="1"/>
                    <label for="request_date_from" string="Date début"/>
                    <div>
                        <div class="o_row o_row_readonly o_hr_holidays_dates">
                            <field name="request_date_from" class="oe_inline" attrs="{'readonly': [('state', 'not in', ('draft', 'confirm'))]}"/>
                            <field name="hour_from" attrs="{'readonly': [('state', '=', 'validate')]}"/>
                            <field name="request_date_from_period" widget="radio" options="{'horizontal': True}" attrs="{'readonly': [('state', 'not in', ('draft', 'confirm'))]}"/>
                        </div>
                    </div>
                    <label for="request_date_to" string="Date fin"/>
                    <div>
                        <div class="o_row o_row_readonly o_hr_holidays_dates">
                            <field name="request_date_to" class="oe_inline" attrs="{'readonly': [('state', 'not in', ('draft', 'confirm'))]}"/>
                            <field name="hour_to" attrs="{'readonly': [('state', '=', 'validate')]}"/>
                            <field name="request_date_to_period" widget="radio" options="{'horizontal': True}" attrs="{'readonly': [('state', 'not in', ('draft', 'confirm'))]}"/>
                        </div>
                    </div>


                    <!-- Duration section remains unchanged -->
                    <label for="number_of_days" string="Duration"/>
                    <div>
                        <field name="number_of_days_display" readonly="1" class="oe_inline"/>
                        <span class="ml8">Days</span>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

